// CICSA — reglas desplegables con firebase deploy --only storage.
// La autorización usa el registro administrado en Firestore. El despliegue debe
// verificar el permiso de consulta entre servicios; no se debilita la condición.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function conSesion() {
      return request.auth != null;
    }
    function esDueno() {
      return request.auth.uid == 'NVapfgY8pshXwYbMq7Wz28ry3pC3';
    }
    function tieneRegistro() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }
    function registroValido(data) {
      return data.get('activo', true) is bool
        && data.get('activo', true) == true
        && data.get('rol', 'operativo') in ['admin', 'operativo'];
    }
    function esUsuario() {
      return conSesion() && (
        (tieneRegistro() &&
          registroValido(firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data))
        || (esDueno() && !tieneRegistro())
      );
    }
    function esAdmin() {
      return esUsuario() && (esDueno() ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('rol', 'operativo') == 'admin');
    }

    // Facturas de creación única. No se permite cambiar sus bytes ni metadatos.
    // El MIME es declarado por el cliente; no sustituye la validación del archivo.
    match /facturas/{archivo} {
      allow read: if esUsuario();
      allow create: if resource == null && esUsuario()
        && request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/gif',
          'image/heic', 'image/heif', 'image/avif', 'image/tiff', 'image/bmp'
        ];
      allow update: if false;
      allow delete: if esAdmin();
    }

    // Los cortes usan un nombre por periodo y la app necesita reimportarlos.
    match /cortes/{archivo} {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/json';
      allow delete: if esAdmin();
    }
    // El archivo mensual: la copia completa de un mes que la app escribe y vuelve a releer para
    // comprobarla. Sin este bloque la ruta caía en el deny final y archivar devolvía 403.
    // Se permite update porque un mes se REESCRIBE cuando alguien corrige un movimiento suyo; el
    // nombre es fijo por mes (archivo/2026-09.json), así que no se acumulan versiones sueltas.
    // La lectura es para cualquier usuario, no solo admin: el archivo contiene los MISMOS
    // movimientos del documento compartido que ese usuario ya puede leer, así que restringirlo
    // no protegería nada y dejaría al personal operativo sin los meses archivados en el Balance.
    // El borrado queda denegado a todos, incluido el dueño: cuando la fase 3 quite el mes del
    // documento, este archivo será la ÚNICA copia de esa contabilidad. Si alguna vez hay que
    // quitar uno, se hace desde la consola, a mano y a propósito.
    match /archivo/{mes} {
      allow read: if esUsuario();
      allow create, update: if esAdmin()
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/json';
      allow delete: if false;
    }
    // Las demás rutas, incluidas subcarpetas no declaradas, quedan denegadas.
  }
}
