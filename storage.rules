// CICSA — reglas desplegables con firebase deploy --only storage.
// La autorización usa el registro administrado en Firestore. El despliegue debe
// verificar el permiso de consulta entre servicios; no se debilita la condición.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function conSesion() {
      return request.auth != null;
    }
    function esDueno() {
      return request.auth.uid == 'NVapfgY8pshXwYbMq7Wz28ry3pC3';
    }
    function tieneRegistro() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }
    function registroValido(data) {
      return data.get('activo', true) is bool
        && data.get('activo', true) == true
        && data.get('rol', 'operativo') in ['admin', 'operativo'];
    }
    function esUsuario() {
      return conSesion() && (
        (tieneRegistro() &&
          registroValido(firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data))
        || (esDueno() && !tieneRegistro())
      );
    }
    function esAdmin() {
      return esUsuario() && (esDueno() ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('rol', 'operativo') == 'admin');
    }

    // Facturas de creación única. No se permite cambiar sus bytes ni metadatos.
    // El MIME es declarado por el cliente; no sustituye la validación del archivo.
    match /facturas/{archivo} {
      allow read: if esUsuario();
      allow create: if resource == null && esUsuario()
        && request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/gif',
          'image/heic', 'image/heif', 'image/avif', 'image/tiff', 'image/bmp'
        ];
      allow update: if false;
      allow delete: if esAdmin();
    }

    // Los cortes usan un nombre por periodo y la app necesita reimportarlos.
    match /cortes/{archivo} {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/json';
      allow delete: if esAdmin();
    }
    // Las demás rutas, incluidas subcarpetas no declaradas, quedan denegadas.
  }
}
