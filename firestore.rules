// CICSA — reglas desplegables con firebase deploy --only firestore:rules.
// Usuarios heredados sin activo/rol conservan acceso operativo.
// El presupuesto continúa dentro del JSON de estado/cicsa: su aislamiento
// administrativo requiere la migración de datos pendiente del hallazgo W12.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() {
      return request.auth != null;
    }
    function esDueno() {
      return request.auth.uid == 'NVapfgY8pshXwYbMq7Wz28ry3pC3';
    }
    function registroValido(data) {
      return data.get('activo', true) is bool
        && data.get('activo', true) == true
        && data.get('rol', 'operativo') in ['admin', 'operativo'];
    }
    function tieneRegistro() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function esUsuario() {
      return conSesion() && (
        (tieneRegistro() &&
          registroValido(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data))
        || (esDueno() && !tieneRegistro())
      );
    }
    function esAdmin() {
      return esUsuario() && (esDueno() ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', 'operativo') == 'admin');
    }
    function perfilValido(data) {
      return data.get('activo', true) is bool
        && data.get('rol', 'operativo') in ['admin', 'operativo'];
    }

    // CICSA Menú consulta este documento concreto sin iniciar sesión.
    match /datos/{doc} {
      allow get: if doc == 'precios';
      allow create, update: if doc == 'precios' && esUsuario();
      allow delete: if doc == 'precios' && esAdmin();
    }

    // Mantener lectura de respaldos históricos para su migración por el admin.
    // La aplicación actual solo guarda estado/cicsa; no se borran datos al publicar.
    match /estado/{doc} {
      allow read: if esUsuario();
      allow create, update: if doc == 'cicsa' && esUsuario();
      allow delete: if esAdmin();
    }

    // Leer el perfil propio permite informar una desactivación y autorizar el
    // backend. Esta excepción nunca permite crear ni modificar ese registro.
    match /usuarios/{uid} {
      allow read: if esAdmin() || (conSesion() && request.auth.uid == uid);
      allow create, update: if esAdmin() && perfilValido(request.resource.data);
      allow delete: if esAdmin();
    }

    match /chat/{msg} {
      allow read: if esUsuario();
      allow create: if esUsuario() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if esAdmin();
    }
    match /productos_comerciales/{doc} {
      allow read, write: if esUsuario();
    }
    match /proveedores/{doc} {
      allow read, write: if esUsuario();
    }
    match /cfdis/{uuid} {
      allow read, create, update: if esUsuario();
      allow delete: if esAdmin();
    }
    match /gmail_revisados/{doc} {
      allow read, create, update: if esUsuario();
      allow delete: if esAdmin();
    }

    // Todos pueden crear el respaldo diario; solo el índice se actualiza.
    // El contenido completo y el listado de copias se reservan al administrador.
    match /respaldos/{doc} {
      allow get: if esAdmin() || (doc == '_indice' && esUsuario());
      allow list: if esAdmin();
      allow create: if esUsuario();
      allow update: if doc == '_indice' && esUsuario();
      allow delete: if esAdmin();
    }
    match /actividad/{uid} {
      allow read: if esAdmin() || (esUsuario() && request.auth.uid == uid);
      allow create, update: if esUsuario() && request.auth.uid == uid;
      allow delete: if esAdmin();
    }
    // Cualquier colección no declarada queda denegada.
  }
}
